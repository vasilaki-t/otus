# Production environment template (HW-21).
# Copy to `.env.production` on the prod host (or `shared/.env`) and fill in
# real secrets. NEVER commit the real .env.production (it is gitignored).
#
#   cp .env.production.example .env.production
#   php artisan key:generate --env=production

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-prod-host

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Higher cost factor for production password hashing.
BCRYPT_ROUNDS=12

# Production logging: file + (optional) Telegram for errors.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Telegram error delivery (optional). Set LOG_STACK=single,telegram to enable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_LOG_LEVEL=error

# Database — matches compose.prod.yaml service name `pgsql`.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=otus
DB_USERNAME=otus
DB_PASSWORD=change-me-in-production

# Redis — used for cache, sessions and queue in production.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production drivers: Redis-backed cache/sessions/queue for performance.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
CACHE_PREFIX=otus
CACHE_WARM_TTL=600

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Memcached fallback (only if you switch SESSION/CACHE to memcached).
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# Mail — point at a real SMTP relay in production.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-prod-host"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public web port exposed by compose.prod.yaml (host side).
APP_PORT=8080
