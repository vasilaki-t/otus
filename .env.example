APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
# SAIL_XDEBUG_MODE=develop,debug
# SAIL_XDEBUG_CONFIG=client_host=host.docker.internal client_port=9003

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Telegram error logging
# To enable Telegram error delivery in production set LOG_CHANNEL=app
# (or LOG_STACK=single,telegram) and fill the values below.
# Errors (level error and above) are sent to Telegram via Monolog's
# TelegramBotHandler; everything is still written to the file log, and if
# Telegram is unreachable the error falls back to storage/logs/telegram-fallback.log
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=vasilaki
DB_USERNAME=postgres
DB_PASSWORD=password

SESSION_DRIVER=database
# Store sessions in Memcached on production (requires ext-memcached + a running
# memcached server). Locally/CI keep `database` (or `array` in tests).
# SESSION_DRIVER=memcached
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Use Memcached for the logic-level cache on production:
# CACHE_STORE=memcached
# CACHE_PREFIX=

# Logic-level cache TTL (seconds) for StatisticsCache / cache:warm.
CACHE_WARM_TTL=600

# Memcached connection (used when SESSION_DRIVER/CACHE_STORE=memcached).
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
